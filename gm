	new bool: occupied[MAX_VEHICLES];
	for (new v = 1; v < MAX_VEHICLES; v++)
	{
		if (v > AUTOS)
		{
			foreach(Player, i)
			{
				if (v == autos[i] || v == autos2[i] || v == autos3[i] || v == autos4[i] || v == GetPlayerVehicleID(i)) occupied[v] = true;
			}
			if (!occupied[v])
			{
				MotorAuto[v] = 0;
				DestroyVehicle(v);
			}
		}
	}
	return 1;
}


