public AntiSpeedHack()
{
	for(new i=0; i<MAX_PLAYERS; i++)
	{
		if(JugadorLogeado[i] == 1)
		{
			if(ObtenerVelocidad(i)> 300)
			{

				if(!IsPlayerInAnyVehicle(i))
				{
					new pName[24], string[256], texto[30], playerState = GetPlayerState(i);
					GetPlayerName(i,pName,24);
					format(string, 256,"El jugador {FF3300}%s(ID: %d){FFFFFF} fue baneado por el anticheat. Razón: {FF3300}Super Choque (%d/%d/%d){FFFFFF}.",pName,i, GetVehicleModel(GetPlayerVehicleID(i)), ObtenerVelocidad(i),playerState);
					format(texto, sizeof(texto), "Super Choque (%d/%d/%d)", GetVehicleModel(GetPlayerVehicleID(i)), ObtenerVelocidad(i),playerState);
					format(PlayerInfo[i][pRazon], 32, texto);
					PlayerInfo[i][pBan] = 1;
					SendClientMessageToAll(-1,string);
					Kick(i);
					return 1;
				}
				switch(GetVehicleModel(GetPlayerVehicleID(i)))
				{
					case 0,511,460,592,577,512,513,520,553,593,476,519: printf("",i,GetVehicleModel(GetPlayerVehicleID(i)),ObtenerVelocidad(i));
					default:
					{
						new pName[24], string[256], texto[30], playerState = GetPlayerState(i);
						GetPlayerName(i,pName,24);
						format(string, 256,"El jugador {FF3300}%s(ID: %d){FFFFFF} fue baneado por el anticheat. Razón: {FF3300}Super Choque (%d/%d/%d){FFFFFF}.",pName,i, GetVehicleModel(GetPlayerVehicleID(i)), ObtenerVelocidad(i),playerState);
						format(texto, sizeof(texto), "Super Choque (%d/%d/%d)", GetVehicleModel(GetPlayerVehicleID(i)), ObtenerVelocidad(i),playerState);
						format(PlayerInfo[i][pRazon], 32, texto);
