			EnPatrulla[ID] = 1;
			PutPlayerInVehicle(ID, patrulla, 2);
			VariableCaido[ID] = 0;
			TogglePlayerControllable(ID, 0);
			SetPVarInt(ID, "IsFrozen", 0);
