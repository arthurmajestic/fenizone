		TiempoDuda[id] = tiempo*60;
		SetTimerEx("DudaOn",calculo,0,"d",id);
		format(string, sizeof(string), "A %s no se le permite hablar en el chat de ayuda. Razón: %s.",NombreJugador(id), razon);
		SendClientMessageToAll(0xAA3333FF,string);
		for(new i=0;i<MAX_PLAYERS;i++)
		{
			if(PlayerInfo[i][jAdminNvl] > 3)
			{
				format(string, 128, "Tiempo de muteo: %d minutos, Administrador: %s",tiempo,NombreJugador(playerid));
				SCM(i,COLOR_GREY,string);
			}
		}
		format(string2,128,"No se te permite hablar en el chat de ayuda. Por %d minuto(s)",tiempo);
		SCM(id,0xDEA600FF,string2);

		new message[120];
		format(message, 120, "%s muteo a %s por %s (Tiempo: %d).", NombreJugador(playerid), NombreJugador(id), razon, tiempo);
		Log("logs/mute.log", message);
	}
	else return SCM(playerid,-1,"Usa /mutear [id] [tiempo (minutos)] [razón]");
	return 1;
}

