CMD:numero(playerid,params[])
{
	new ID,pName[32],string[256];
	if(PlayerInfo[playerid][pAgenda] != 1) return SendClientMessage(playerid, -1, "Tu no tienes una agenda telefonica");
	if(sscanf(params,"d", ID)) return SendClientMessage(playerid, -1, "Utiliza /numero [ID]");
	if (!IsPlayerConnected(ID)) return SendClientMessage(playerid,COLOR_WHITE,"Jugador no conectado");
	if(PlayerInfo[ID][pNumero] == 0) return SendClientMessage(playerid, -1, "No se puede encontrar el numero de esta persona, puede que no tenga teléfono");
	GetPlayerName(ID, pName,32);
	format(string, 256, "El numero de {DBED15}%s{FFFFFF} es {DBED15}%d{FFFFFF}",pName,PlayerInfo[ID][pNumero]);
	SendClientMessage(playerid, -1, string);
	return 1;
}

CMD:llamar(playerid, params[])
{
	new string[128], phonenumb,pName[50];
	GetPlayerName(playerid, pName, 50);
	if(sscanf(params, "d", phonenumb)) return SendClientMessage(playerid, COLOR_WHITE, "USO: /llamar [Número]");
	if(PlayerInfo[playerid][pTiempoCarcelS] > 0 || PlayerInfo[playerid][pTiempoJailS] > 0) return SCM(playerid,-1,"No puedes usar tu telefono en este momento.");
    if(phonenumb == 911 && PlayerInfo[playerid][pDuty] == 1) return SendClientMessage(playerid, -1, "No puedes llamar al 911 si eres un policía en actividad, usa tu radio.");
	if(PlayerInfo[playerid][pNumero] == 0) return SendClientMessage(playerid, COLOR_GRAD2, "No tienes un teléfono.");
	if(PlayerInfo[playerid][pNumero] == phonenumb) return SCM(playerid,-1,"Número inválido");
	if(EnLlamada[playerid] == 1) return SCM(playerid,-1,"Ya estas en una llamada, usa /colgar para terminarla");
	format(string, sizeof(string), "%s saca su telèfono y marca un número.", pName);
	ProxDetector(30.0, playerid, string, COLOR_VERDECLARO,COLOR_VERDECLARO,COLOR_VERDECLARO,COLOR_VERDECLARO,COLOR_VERDECLARO);
	SetPlayerSpecialAction(playerid, SPECIAL_ACTION_USECELLPHONE);
	PlayerPlaySound(playerid, 3600, 0.0, 0.0, 0.0);
	for(new i=0;i<MAX_PLAYERS; i++)
	{
		if(phonenumb == 911)
		{
			PlayerInfo[playerid][MobileSub] = 911;
			SetPlayerSpecialAction(playerid, SPECIAL_ACTION_USECELLPHONE);
			SetTimerEx("LlamadaCops",2000,false,"d",playerid);
			SendClientMessage(playerid, -1, "Llamando a la policía... usa {DBED15}/colgar{FFFFFF} para cancelar la llamada.");
			return 1;
		}
		if(PlayerInfo[i][pNumero] == phonenumb && phonenumb != 0)
		{
		    if(PlayerInfo[i][pTiempoCarcelS] > 0 || PlayerInfo[i][pTiempoJailS] > 0) return SCM(playerid,-1,"El numero que usted marco no esta disponible en este momento.");
			if(EnLlamada[i] == 1) return SCM(playerid,-1,"El numero que usted marco se encuentra ocupado");
			if(TelefonoEstado[i] == 1) return SCM(playerid,-1,"El numero que marco esta fuera de linea");
			{
				new pName2[50];
				GetPlayerName(i,pName2,50);
				if(IsPlayerConnected(i)){
					if(i != INVALID_PLAYER_ID){
						if (PlayerInfo[i][MobileSub] == INVALID_PLAYER_ID)
						{
							SetPlayerSpecialAction(playerid, SPECIAL_ACTION_USECELLPHONE);
							format(string, sizeof(string), "El teléfono de %s está sonando.", pName2);
							ProxDetector(30.0, i, string, COLOR_VERDECLARO,COLOR_VERDECLARO,COLOR_VERDECLARO,COLOR_VERDECLARO,COLOR_VERDECLARO);
							format(string, sizeof(string), "Te están llamando por teléfono desde el número: {DBED15}%d{FFFFFF}, usa {DBED15}/atender{FFFFFF} o {DBED15}/colgar", PlayerInfo[playerid][pNumero]);
							SendClientMessage(i, -1, string);
							PlayerInfo[playerid][MobileSub] = i;
							PlayerInfo[i][MobileSub] = playerid;
							llamada(i);
							return 1;
						}
					}
				}
			}
		}
	}
	SendClientMessage(playerid, COLOR_GRAD2, "Su llamada no puede darse por el numero marcado, por favor, compruebe el número e inténtelo nuevamente.");
	SetTimerEx("StopCell",3000,false,"d",playerid);
	return 1;
}

CMD:sms(playerid, params[])
{
	new numero,mensaje[110],pName[32],string[128],pNameSub[50];
	if(!sscanf(params,"ds[110]",numero,mensaje))
	{
		if(PlayerInfo[playerid][pTiempoCarcelS] > 0 || PlayerInfo[playerid][pTiempoJailS] > 0) return SCM(playerid,-1,"No puedes usar tu telefono en este momento.");
		if(PlayerInfo[playerid][pNumero] == 0) return SCM(playerid, -1, "Necesitas tener un teléfono para enviar un SMS");
		if(PlayerInfo[playerid][jDinero] < 10) return SCM(playerid, -1, "No tienes el dinero suficiente para enviar un sms ($15)");
		if(PlayerInfo[playerid][pNumero] != numero)
		{

			for(new i=0;i<MAX_PLAYERS;i++)
			{

				if(PlayerInfo[i][pNumero] == numero)
				{

					if(TelefonoEstado[i] == 0)
					{

						GetPlayerName(i,pName,32);
						GetPlayerName(playerid, pNameSub, 50);
						SCM(playerid, COLOR_DORADO,"Mensaje enviado con éxito.");
						format(string, 128,"((SMS de %s [%d])): %s",pNameSub,PlayerInfo[playerid][pNumero], mensaje);
						SCM(i,COLOR_DORADO,string);
						QuitarDinero(playerid, 15);
						return 1;
					}
					else return SCM(playerid,-1,"El número que has marcado se encuentra desconectado, intentalo más tarde.");
				}
			}
		}
	}
	else return SCM(playerid, -1, "Modo de uso /sms [número de teléfono] [mensaje]");
	return 1;
}

CMD:atender(playerid, params[])
{
	new string[150],pName[50],pName2[50],texto[10],id,Float:Pos[3];
	GetPlayerName(playerid, pName, 50);
	if(!sscanf(params,"s[10]d",texto,id))
	{
		if(strcmp(texto, "paciente", true)==0)
		{

			new Float:Vida;
			if(PlayerInfo[playerid][jJob] != 1) return SCM(playerid,-1,"Necesitas el trabajo de médico para utilizar este comando");
			if(GetPlayerSkin(playerid) != 275) return SCM(playerid,-1,"Necesitas tener la ropa de médico para utilizar este comando");
			if(PlayerInfo[playerid][pMedicina] == 0) return SCM(playerid,-1,"No tienes ninguna medicina para aplicar");
			GetPlayerPos(id,Pos[0],Pos[1],Pos[2]);
			if(!IsPlayerInRangeOfPoint(playerid, 2.0,Pos[0],Pos[1],Pos[2])) return SCM(playerid,-1,"Tu no estas cerca de este paciente");
			if(PlayerInfo[id][pAtendido] == 1) return SCM(playerid,-1,"Este paciente ya fue atendido por otro médico");
			GetPlayerHealth(id,Vida);
			if(PlayerInfo[id][pEnfermedad] == PlayerInfo[playerid][pMedicina])
			{

				if(Vida < 90) { SetPlayerHealth(id, 90); }
				GetPlayerName(id,pName2,50);
				format(string,sizeof(string),"%s aplica el tratamiento necesario con el paciente",pName);
				ProxDetector(15.0, playerid, string, COLOR_VERDECLARO,COLOR_VERDECLARO,COLOR_VERDECLARO,COLOR_VERDECLARO,COLOR_VERDECLARO);
				format(string,sizeof(string),"%s comienza a curar las heridas de %s ",pName,pName2);
				ProxDetector(15.0, playerid, string, COLOR_VERDECLARO,COLOR_VERDECLARO,COLOR_VERDECLARO,COLOR_VERDECLARO,COLOR_VERDECLARO);
				format(string,sizeof(string),"El tratamiento parece ir correctamente");
				ProxDetector(15.0, playerid, string, COLOR_VERDECLARO,COLOR_VERDECLARO,COLOR_VERDECLARO,COLOR_VERDECLARO,COLOR_VERDECLARO);
				PlayerInfo[id][pAtendido] = 1;
				PlayerInfo[playerid][pMedicina] = 0;
				if(PlayerInfo[id][jDinero] >= 600)
				{

					QuitarDinero(id,600);
					DarDinero(playerid,600);
					SCM(playerid,-1,"El paciente te ha pagado {00CC00}$600{FFFFFF} por tu gran trabajo");
					SCM(id,-1,"Has pagado {00CC00}$600{FFFFFF} de tu billetera al médico por su trabajo");
				}
				else if(PlayerInfo[id][pBanco] >= 600)
				{

					PlayerInfo[id][pBanco] -= 600;
					DarDinero(playerid,600);
					SCM(playerid,-1,"El paciente te ha pagado {00CC00}$600{FFFFFF} por tu gran trabajo");
					SCM(id,-1,"Has pagado {00CC00}$600{FFFFFF} del banco al médico por su trabajo");
				}
				else
				{

					DarDinero(playerid,250);
					SCM(playerid,-1,"El paciente no tiene suficiente dinero para pagar los servicios, el hospital te ha pagado $250");
					SCM(id,-1,"No has tenido dinero para pagarle al médico, el hospital cubrio tu cuota");
				}
			}
			else
			{

				if(Vida > 10) { SetPlayerHealth(id, 10); }
				GetPlayerName(id,pName2,50);
				format(string,sizeof(string),"%s aplica el tratamiento erroneo con el paciente",pName);
				ProxDetector(15.0, playerid, string, COLOR_VERDECLARO,COLOR_VERDECLARO,COLOR_VERDECLARO,COLOR_VERDECLARO,COLOR_VERDECLARO);
				SCM(playerid,COLOR_RED,"Haz aplicado un tratamiento erroneo con el paciente, tu reputacion como medico ha disminuido");
			}
		}
		return 1;
	}
	if(sscanf(params, "s[30]", texto))
	{

		for(new i=0;i<MAX_PLAYERS;i++)
		{

			if(PlayerInfo[i][MobileSub] == 911)
			{

				if(PlayerInfo[playerid][pDuty] == 1)
				{

					EnLlamada[playerid] = 1;
					GetPlayerName(i, pName2, 50);

					PlayerInfo[i][Mobile] = playerid;
					PlayerInfo[i][MobileSub] = INVALID_PLAYER_ID;
					EnLlamada911[i] = 911;

					PlayerInfo[playerid][Mobile] = i;
					PlayerInfo[playerid][MobileSub] = INVALID_PLAYER_ID;
					EnLlamada911[playerid] = 911;

					format(string, sizeof(string), "%s contesta su teléfono.",pName);
					ProxDetector(15.0, playerid, string, COLOR_VERDECLARO,COLOR_VERDECLARO,COLOR_VERDECLARO,COLOR_VERDECLARO,COLOR_VERDECLARO);

					format(string,sizeof(string),"{3399FF}[Central de policía]{FFFFFF} %s %s contesta la llamada de %s.",RangoPolicia(playerid),pName,pName2);
					SendRadioMessage(1,-1,string,INVALID_PLAYER_ID);

					format(string,sizeof(string),"{3399FF}[Central de policía]{FFFFFF} %s %s ha contestado su llamada",RangoPolicia(playerid),pName);
					SendClientMessage(i, -1, string);

					SetPlayerSpecialAction(playerid, SPECIAL_ACTION_USECELLPHONE);
					return 1;
				}
			}
		}
		if(Mobile2[playerid] == 2540)
