CMD:darfaccion(playerid, params[])
{
	new string[126];
	new ID,FACCION;
	if(PlayerInfo[playerid][jAdminNvl] < 6) return 0;
	if(sscanf(params, "rd", ID,FACCION) )return SendClientMessage(playerid,COLOR_GRAD2,"Uso /darfaccion [id] [numero]");
	//if(!IsPlayerConnected(ID)) return SendClientMessage(playerid,COLOR_GRAD2,"Jugador desconectado o id incorrecta");
	if(FACCION == 0)
	{
	    if(PlayerInfo[ID][jMiembro] == 1)
		{
			SetPlayerSkin(ID, PlayerInfo[ID][jRopa]);
			ClearAnimations(ID);
		}
		PlayerInfo[ID][pDuty] = 0;
		PlayerInfo[ID][jMiembro] = 0;
		PlayerInfo[ID][pRango] = 0;
		return 1;
	}
	if(FACCION == 1)
	{
		format(string, sizeof(string), "¡Felicitaciones! %s te ha hecho a lider de la faccion S.A.P.D", NombreJugador(playerid));
		SCM(ID,0x2AFF0000, string);
		format(string, sizeof(string), "%s has hecho lider de la faccion S.A.P.D a %s", NombreJugador(playerid), NombreJugador(ID));
		SCM(playerid,0x2AFF0000, string);
		PlayerInfo[ID][jMiembro] = FACCION;
		PlayerInfo[ID][pRango] = 7;
		return 1;
	}
	if(FACCION > 1)
   	{
   		PlayerInfo[ID][jMiembro] = FACCION;
   		PlayerInfo[ID][pRango] = 6;
   		SCM(playerid,-1,"Has hecho al usuario lider de la faccion");
   		SCM(ID,-1,"Ahora eres el lider de una faccion");
 	}
	return 1;
}

CMD:kick(playerid, params[])
{
	new string[256];
	new ID,ADMIN[256];
	if(PlayerInfo[playerid][jAdminNvl] < 4) return 0;
	if(sscanf(params, "ds[256]", ID,ADMIN) )return SendClientMessage(playerid,COLOR_WHITE,"Uso: /kick [id] [razón]");
	if(!IsPlayerConnected(ID)) return SendClientMessage(playerid,COLOR_WHITE,"Jugador desconectado o id incorrecta");
	format(string, sizeof(string), "El jugador {FF3300}%s(ID: %d){FFFFFF} fue expulsado por un admin. Razón: {FF3300}%s{FFFFFF}.",NombreJugador(ID),ID, ADMIN);
	SendClientMessageToAll(-1, string);
	SCM(ID, -1, string);
	for(new i=0;i<MAX_PLAYERS;i++)
	{
		if(PlayerInfo[i][jAdminNvl] > 3)
		{
			format(string, 128, "Administrador: %s",NombreJugador(playerid));
			SCM(i,COLOR_GREY,string);
		}
	}
	Kick(ID);
	return 1;
}

