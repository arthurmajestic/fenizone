	if(!sscanf(params, "s[32]", item))
	{
		if(strcmp(item,"vip",true)==0)
		{
	        if(PlayerInfo[playerid][Moneda] < 10) return SendClientMessage(playerid,-1,"No tienes suficientes DC para comprar VIP (10DC)");
