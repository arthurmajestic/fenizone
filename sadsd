	{

		PlayerInfo[playerid][pVip] = 0;
		mysql_format(handle_db, Query, sizeof(Query), "UPDATE `usuarios` SET `FinDia`='0',`FinMes`='0',`FinAno`='0' WHERE `Username`='%e'",PlayerInfo[playerid][Nickname]);
