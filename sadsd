CMD:puxartodos(playerid, params[])
{
	if(PlayerInfo[playerid][pAdmin] < 7) return 0;
    new pName[50];
    new Float:X,Float:Y,Float:Z,Float:A;
	for(new id = 0; id < MAX_PLAYERS; id++)
	{
		if(IsPlayerConnected(id))
		{
			if(IsPlayerInAnyVehicle(id))
			{
				GetPlayerName(id,pName,50);
				new
					interior = GetPlayerInterior(playerid),
					veiculo = GetPlayerVehicleID(id)
				;
				GetPlayerPos(playerid, X, Y, Z);
				GetPlayerFacingAngle(playerid,A);
				SetVehiclePos(veiculo, X+2, Y+2, Z+2);
				SetPlayerInterior(id, interior);
				LinkVehicleToInterior(veiculo, interior);
				SetVehicleVirtualWorld(veiculo,GetPlayerVirtualWorld(playerid));
				SetPlayerVirtualWorld(id,GetPlayerVirtualWorld(playerid));

				DarRoupas(id);
			}
			else
			{
				GetPlayerPos(playerid, X, Y, Z);
				GetPlayerFacingAngle(playerid,A);
				SetPlayerPos(id, X+1, Y+1, Z+1);
				SetPlayerVirtualWorld(id,GetPlayerVirtualWorld(playerid));
				SetPlayerInterior(id,GetPlayerInterior(playerid));

				DarRoupas(id);
			}
		}
	}
	for(new z=0;z<MAX_PLAYERS;z++)
	{
