CMD:telefone(playerid,params[])
{
	new item[32];
	if(!sscanf(params,"s[32]",item))
	{
		if(strcmp(item, "on", true)==0)
		{
			if(PlayerInfo[playerid][pNumero] <= 0) return SendClientMessage(playerid,-1,"Você não tem um telefone celular.");
			if(TelefonoEstado[playerid] == 0) return SendClientMessage(playerid,-1,"Seu telefone já está ligado.");
			{
				TelefonoEstado[playerid] = 0;
				if(PlayerTemp[playerid][@Specteando] == 0) AccionesRol(playerid,"ligou o celular.", 20);
			}
		}
		if(strcmp(item, "off", true)==0)
		{
			if(PlayerInfo[playerid][pNumero] <= 0) return SendClientMessage(playerid,-1,"Você não tem um telefone celular.");
			if(TelefonoEstado[playerid] == 1) return SendClientMessage(playerid,-1,"Seu telefone já está desligado.");
			{
				if(PlayerInfo[playerid][MobileSub] == 2540 || PlayerInfo[playerid][MobileSub] == 911)  ColgarLaLlamada(playerid);
				new caller = PlayerInfo[playerid][MobileSub];
				if(IsPlayerConnected(caller) && caller != -1)
				{
					SendClientMessage(caller, -1, "Desligaram a ligação.");
					SetPlayerSpecialAction(caller, SPECIAL_ACTION_STOPUSECELLPHONE);
					RemovePlayerAttachedObject(caller, 2);
					PlayerInfo[caller][MobileSub] = -1;
					EnLlamada[caller] = 0;
					finllamada(caller);
    				ColgarLaLlamada(playerid);
				}
				TelefonoEstado[playerid] = 1;
				if(PlayerTemp[playerid][@Specteando] == 0) AccionesRol(playerid,"desligou o celular.", 20);
			}
		}
	}
	else return SendClientMessage(playerid,-1,"Escreva {0BC8D5}/telefone on/off");
	return 1;
}
