CMD:proteger(playerid,params[])
{
	new id,precio,Float:x,Float:y,Float:z,string[256];
	if(PlayerInfo[playerid][pFaccion] < 1)  return SendClientMessage(playerid,-1,"Você não faz parte de uma facção.");
	//if(PlayerInfo[playerid][pTiempoCarcelM] > 0 || PlayerInfo[playerid][pTiempoJail] > 0 || PlayerInfo[playerid][Agonizando] != 0) return 1;
	if(EnCombate[playerid] == 1) return SendClientMessage(playerid,-1,"Você não pode fazer isso em combate, espere alguns segundos e tente novamente.");
	if(!sscanf(params, "dd", id,precio))
	{
		if(IsPlayerConnected(id))
		GetPlayerPos(id, x,y,z);
		if(id == playerid) return 1;
		if(!IsPlayerInRangeOfPoint(playerid, 5.0, x,y,z)) return SendClientMessage(playerid, -1, "Você não está perto deste jogador.");
		if(EnCombate[id] == 1) return SendClientMessage(playerid,-1,"Você não pode oferecer um colete a um jogador que está em combate.");
		if(precio >=400 && precio <= 1000)
		{
		    if(Tiempos[playerid][TiempoCubrir] > 0)
		    {
		        SendClientMessage(playerid,-1,"Você só pode proteger alguém uma vez por minuto.");
		        MensajeEx(playerid,-1,"Por favor espere {FF0000}%d{FFFFFF} segundos.",Tiempos[playerid][TiempoCubrir]);
		        return 1;
		    }
			format(string, 256, "{03C5DF}%s{FFFFFF} te ofereceu um colete de proteção por {2BFF00}$%d{FFFFFF}, para aceitar use {DBED15}/aceitar protecao", PlayerInfo[playerid][Nickname], precio);
			SendClientMessage(id,-1,string);
			Tiempos[playerid][TiempoCubrir] = 60;
			format(string, 256, "Você ofereceu um colete à prova de balas para {03C5DF}%s{FFFFFF} por {2BFF00}$%d{FFFFFF}.", PlayerInfo[id][Nickname], precio);
			SendClientMessage(playerid, -1, string);
			GuardaEspalda[id] = playerid;
			SetTimerEx("OfertaPerdida",60000,false,"d",id);
			dineropedido[id] = precio;
		}
		else SendClientMessage(playerid, 0xFF0000FF, "Você não pode cobrar mais de $1000 para proteger alguém com sua armadura.");
	}
	else return SendClientMessage(playerid, -1, "Escreva /proteger [ID] [Valor]");
	return 1;
}

