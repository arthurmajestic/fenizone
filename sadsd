public TimerDeSegundo()
{
	static str[128];
	foreach (new i : Player)
	{

		if(IsPlayerConnected(i))
		{
			if(PlayerInfo[i][pBarras] == 1)
			{
	
				format(str, sizeof(str), "%d%c", PlayerInfo[i][pHambre], '%');
				PlayerTextDrawSetString(i, PlayerTextdraws[i][pTextdraws][63], str);

				format(str, sizeof(str), "%d%c", PlayerInfo[i][pSed], '%');
				PlayerTextDrawSetString(i, PlayerTextdraws[i][pTextdraws][64], str);
			}
			
		}
	}
	if(TiempoEsperad >= 1)
	{
		TiempoEsperad --;
	}
	if(TiempoEsperaGuardarFabrica >= 1)
	{
	    TiempoEsperaGuardarFabrica --;
	}
	for(new i = 0; i < MAX_PLAYERS; i++) //Loop de playerids
	{
		if(Tiempos[i][TiempoCargo] > 0)
		{
		    Tiempos[i][TiempoCargo] --;
		    if(Tiempos[i][TiempoCargo] == 0)
		    {
			    if(PlayerInfo[i][pCargos] < 3 && PlayerInfo[i][pCargos] > 0)
				{
				    new value = 0;
				    if(RoboTienda[i] == 1)
					{
				        for(new c = 0; c < MAX_PLAYERS; c++)
						{
			   				if(PlayerInfo[c][pFaccion] == 1 && PlayerInfo[c][pDuty] == 1 && EstaEnP(i,c,30.00))
							{
								Tiempos[i][TiempoCargo] = 60;
						    	SendClientMessage(i,-1,"A {3399FF}policía{FFFFFF} esta muito perto, {FF0000}tente escapar{FFFFFF} para as estrelas sumirem.");
							}
							else value = 1;
						}
						if(value == 1)
						{
						    RoboTienda[i] = 0;
							SendClientMessage(i,-1,"A {3399FF}policía{FFFFFF} parou de te procurar, agora {00CC00}pode roubar{FFFFFF} outros negócios.");
							PlayerInfo[i][pCargos] = 0;
