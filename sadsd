SendMessageToTwitterChannel(playerid, message[])
{
	new str[500],string[2000],pos,player = -1,count = 0,limit = -1;
	format(string,2000,"%s",message);
	while(-1 != (pos = strfind(string, "@", false, pos)))
	{
		new subtext[MAX_PLAYER_NAME+20];
		strmid(subtext, string, pos, pos+4);
		if(!sscanf(subtext,"'@'I(-1)",player))
		{
			if(IsPlayerConnected(player))
			{
				switch(player)
				{
					case 0..9:strdel(string,pos,pos+2);
					case 10..99:strdel(string,pos,pos+3);
					case 100..999:strdel(string,pos,pos+4);
				}
				format(subtext, sizeof(subtext), "%s(%d)",PlayerInfo[player][Nickname],player);
				strins(string,subtext,pos);
			}
			else pos++;
		}
		else pos++;
		if(pos >= strlen(string))break;
		if(limit != -1 && ++count >= limit)break;
	}

	format(str, 500, "Twitter @%s(%d): %s", PlayerInfo[playerid][Nickname], playerid, string);
	if(IsPlayerConnected(player)) SendClientMessage(player,-1,"Twitter: Te han mencionado");

	PlayerTemp[playerid][pt_TWITTER_CHANNEL_TIME] = gettime();
	for(new i = 0, j = GetPlayerPoolSize(); i <= j; i++)
	{
		if(IsPlayerConnected(i))
		{
				SendClientMessage(i, 0x4FD2C8FF, str);
		}
	}
	return 1;
}

