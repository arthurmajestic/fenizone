CMD:expulsar(playerid,params[])
{
	new id,string[250];
	if(PlayerInfo[playerid][@Nivel] == 1) return SendClientMessage(playerid,-1,"Você não tem permissão para usar esse comando.");
	if(PlayerInfo[playerid][pTiempoCarcelM] > 0 || PlayerInfo[playerid][pTiempoJail] > 0) return SendClientMessage(playerid,-1,"Você não tem permissão para usar esse comando.");
	if(!sscanf(params,"d",id))
	{
		if(GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
		{
	    	if(Alquilado == false) return SendClientMessage(playerid,-1,"O salão deve está alugado.");
