    {
        new f = MAX_OBJ+1;
        for(new a = 0; a < sizeof(PosObjeto); a++)
        {
            if(PosObjeto[a][0] == 0.0)
            {
                f = a;
                break;
            }
        }
        new string[120];
        if(IsPlayerInRangeOfPoint(playerid, 5.0, PosObjeto[f][0], PosObjeto[f][1], PosObjeto[f][2])) return SendClientMessage(playerid, 0x33AA3300, "No puede tirar armas cerca de una.");
