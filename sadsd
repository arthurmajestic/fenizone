public TempoFomeSede()
{
	foreach (new i : Player)
	{
		if(IsPlayerConnected(i))
		{
			new Float:Vida;
			GetPlayerHealth(i,Vida);
	
			if (PlayerInfo[i][pHambre] > 0)
			{
				PlayerInfo[i][pHambre]--;
			}
			else if (PlayerInfo[i][pHambre] <= 0)
			{
				SetPlayerHealth(i, Vida - 10);
				PlayerInfo[i][pHambre] = 0;
			}
			
			if (PlayerInfo[i][pSed] > 0)
			{
				PlayerInfo[i][pSed]--;
			}
			else if (PlayerInfo[i][pSed] <= 0)
			{
				SetPlayerHealth(i, Vida - 20);
				PlayerInfo[i][pSed] = 0;
			}
	
		}
	}
	return 1;
}

