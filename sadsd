	switch (regalo)
	{
		case 0:
		{
			SendClientMessage(playerid,-1,"Recibes {74F20C}una Cámara y 150k{FFFFFF} de regalo.");
			DarDinero(playerid,150000);
			DarArma(playerid,43);
		}
		case 1:
		{
			MensajeEx(playerid,-1,"Recibes %d de dinero de regalo.",120000+randomMoney);
			DarDinero(playerid,120000+randomMoney);
			DarArma(playerid,43);
		}
		case 2:
		{
			MensajeEx(playerid,-1,"Recibes unos patines de regalo");
			PlayerInfo[playerid][pPatines] = 1;
		}
		case 3:
		{
			MensajeEx(playerid,-1,"Recibes un bate de regalo.");
			DarArma(playerid,5);
		}
		case 4:
		{
			MensajeEx(playerid,-1,"Recibes 10 totems de regalo.");
