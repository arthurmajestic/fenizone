		                            for(new p = 0; p < MAX_PROPIEDADES; p++)
									{
										if(GetPlayerVirtualWorld(i) == PropInfo[p][pVW])
										{
					                        X = PropInfo[p][pPosX];
											Y = PropInfo[p][pPosY];
											Z = PropInfo[p][pPosZ];
										}
									}
		                            SetPlayerMapIcon(playerid, i, X, Y, Z, 0, HexToInt("00CC00FF"), MAPICON_GLOBAL);
								}
								SendClientMessage(playerid, -1,"{00CC00}Você acabou de dizer ao paciente que vai procurá-lo.");
