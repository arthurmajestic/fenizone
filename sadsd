				if(LlamadaMeca[playerid] == 0)
				{
					for(new i, j = GetPlayerPoolSize(); i <= j; i++)
					{
						if(RopaMeca[i] == 1 && (PlayerInfo[i][pTrabajo] == T_Mecanico || PlayerInfo[i][pTrabajo2] == T_Mecanico))
						{
							SetPlayerMarkerForPlayer(i, playerid, COLOR_AZUL);
							SendClientMessage(i, 0x33CCFFAA, "{FFFFFF}Há um novo cliente chamando o {0BC8D5}/servico mecanico{FFFFFF}, para confimar use {0BC8D5}/responder mecanico");
							ResponderMeca[i] = 1;
							TimerMeca[playerid] = SetTimerEx("CancelarLlamada",minutos(5),false,"dd",playerid,1);
						}
					}
					SendClientMessage(playerid, -1,"Você solicitou um mecânico, espere que ele venha até sua posição.");
					LlamadaMeca[playerid] = 1;
				}
				else return SendClientMessage(playerid,-1,"Você já solicitou um mecânico.");
			}
			else return SendClientMessage(playerid,-1,"Você deve estar em um veículo para solicitar um mecânico.");
		}
		else if(sscanf(params, "s[30]", item))
		{
		    SendClientMessage(playerid,-1,"SERVIÇOS: {0BC8D5}/servico medico {FFFFFF}- {0BC8D5}/servico taxi {FFFFFF}- {0BC8D5}/servico guincho {FFFFFF}- {0BC8D5}/servico mecanico");
		}
	}
	return 1;
}
