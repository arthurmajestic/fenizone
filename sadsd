        IDObjeto[f] = IDArma;
        GetPlayerPos(playerid, PosObjeto[f][0], PosObjeto[f][1], PosObjeto[f][2]);
        ObjetoAr[f] = CreateDynamicObject(GunObjects[IDArma][0],PosObjeto[f][0],PosObjeto[f][1],PosObjeto[f][2]-1,93.7,120.0,120.0);
		format(string, sizeof(string), "["COLOR_LIME""SERVER_COIN"{FFFFFF}]\n{FFFFFF}pulsa "COLOR_LIME"'C'{FFFFFF} para tomar el arma.\n");
