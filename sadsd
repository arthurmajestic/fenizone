CMD:salir(playerid, params[])
{
    if(!TiempoValido(Entrando[playerid])) return 1;
    if(TieneBarril[playerid] > 0) return 1;
    if(TieneCajaMeta[playerid] > 0) return 1;
    if(EstaDomiciliaria[playerid] > 0) return 1;
	SalirInterior(playerid);
	return true;
}


