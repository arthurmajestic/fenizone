	if(!IsPlayerConnected(targetid) || IsPlayerNPC(targetid)) return SendClientMessage(playerid, COLOR_BLANCO, "El jugador al que deseas advertir es inválido.");
	if(PlayerInfo[targetid][pAdvertencias] == 3) return BanearAdv(targetid,playerid);
	new cString[128],cString2[128],string[128];
	PlayerInfo[targetid][pAdvertencias] += 1;
	format(cString2, sizeof(cString2), "[*] El jugador {00CCFF}%s (%d){FFFFFF} ha recibido una advertencia por {2ECCFA}%s", PlayerInfo[targetid][Nickname], targetid, motivo);
	MensajeAdmin(COLOR_GREY, cString2, ADMIN_LEVEL_BANEOS);
 	format(string, sizeof(string), "Administrador: %s",PlayerInfo[playerid][Nickname]);
	MensajeAdmin(COLOR_GREY, string, 3);
	format(cString, sizeof(cString), "Has recibido una advertencia por {2ECCFA}%s", motivo);
	SendClientMessage(targetid, COLOR_BLANCO, cString);
	return 1;
}
