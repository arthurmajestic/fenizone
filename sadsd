						if(strcmp(PlayerInfo[playerid][Nickname],Alquilador,true) == 0)	PermisoSalon[id] = false;
	                }
	                else SendClientMessage(playerid,-1,"O jogador deve estar dentro da sala.");
	            }
	            else SendClientMessage(playerid,-1,"Esse jogador está offline.");
	    	}
	    	else SendClientMessage(playerid,-1,"Você não tem permissão para usar esse comando.");
		}
		else if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
		{
			if(TiempoValido(Tiempos[playerid][TiempoExpulsar]))
			{
			    new tmpString[64];
			    format(tmpString, sizeof(tmpString), "Você deve esperar.", Tiempos[playerid][TiempoExpulsar]);
			    return SendClientMessage(playerid, COLOR_WHITE, tmpString);
			}
			if(IsPlayerConnected(id))
			{
				if(id == playerid) return SendClientMessage(playerid, -1, "Você não pode ejetar essa pessoa do veículo.");
				if(IsPlayerInAnyVehicle(id))
				{
					if(GetPlayerVehicleID(playerid) == GetPlayerVehicleID(id))
					{
						new resulT = random(2);
						switch(resulT)
						{
						    case 0:
						    {
							    format(string, sizeof(string), "%s expulsar %s do seu veículo e consegue.", PlayerInfo[playerid][Nickname], PlayerInfo[id][Nickname]);
								ProxDetector(30.0, playerid, string, COLOR_VERDECLARO,COLOR_VERDECLARO,COLOR_VERDECLARO,COLOR_VERDECLARO,COLOR_VERDECLARO);
								RemovePlayerFromVehicle(id);
								Tiempos[playerid][TiempoExpulsar] = TiempoSegundos(59);
						    }
						    case 1:
						    {
						    	format(string, sizeof(string), "%s expulsar %s do seu veículo e não consegue.", PlayerInfo[playerid][Nickname], PlayerInfo[id][Nickname]);
								ProxDetector(30.0, playerid, string, COLOR_VERDECLARO,COLOR_VERDECLARO,COLOR_VERDECLARO,COLOR_VERDECLARO,COLOR_VERDECLARO);
								Tiempos[playerid][TiempoExpulsar] = TiempoSegundos(59);
						    }
						}
					}
					else SendClientMessage(playerid, -1, "Você não pode ejetar essa pessoa do veículo.");
				}
				else SendClientMessage(playerid, -1, "Você não pode ejetar essa pessoa do veículo.");
			}
			else SendClientMessage(playerid, -1, "Você não pode ejetar essa pessoa do veículo.");
		}
		else SendClientMessage(playerid,-1,"Você não tem permissão para usar esse comando.");
	}
	else return SendClientMessage(playerid,-1,"Escreva {DBED15}/expulsar [ID]");
	return true;
}

