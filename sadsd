								break;
							}
						}
					}
				}
				else return SendClientMessage(playerid,-1,"Todas as chamadas já foram atendidas.");
			}
		}
		
		if(strcmp(item,	"mecanico",true) == 0)
		{
			if(PlayerInfo[playerid][pTrabajo] != T_Mecanico && PlayerInfo[playerid][pTrabajo2] != T_Mecanico) return 1;
			if(ResponderMeca[playerid] == 1)
			{
				for(new i=0; i<MAX_PLAYERS;i++)
				{
					if(LlamadaMeca[i] == 1)
					{
						SendClientMessage(i,-1,"{0BC8D5}Um mecânico atendeu sua ligação e está a caminho.");
