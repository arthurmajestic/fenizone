CMD:rall(playerid,params[])
{
	if(PlayerInfo[playerid][pAdmin] < ADMIN_LEVEL_BANEOS) return 0;
 	for(new i=0; i< GetVehiclePoolSize(); i++)
 	{
	 	if(!IsValidVehicle(i)) continue;
		for(new u=0; u< MAX_PLAYERS; u++)
		{
			if(IsPlayerInVehicle(u,i))
			{
				goto _no_borrar;
			}
		}
		SetVehicleToRespawn(i);
		_no_borrar:

	}
	new stringxd[150];
 	format(stringxd,150,"{990033}(Administración): %s respawneo todos los coches.",PlayerName(playerid));
 	MensajeAdmin(-1, stringxd, 5);
	return 1;
}
