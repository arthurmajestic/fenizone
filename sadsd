			Fabricas[id][pEnUso] = 1;
			Fabricas[id][pValor] = precio;
			Fabricas[id][pEnVentaPor] = moneda;
			Fabricas[id][pEntradaX] = Pos[0];
			Fabricas[id][pEntradaY] = Pos[1];
			Fabricas[id][pEntradaZ] = Pos[2];
			Fabricas[id][pEntradaA] = Pos[3];
			Fabricas[id][pID] = id;
			Fabricas[id][pVW] = id+1;
			Fabricas[id][pInt] = id+1;
			format(Fabricas[id][pLocalizacion],80,zone);
			CargarFabricass(id);
			GuardarFabrica(id);
			if(moneda == 0)	format(query,sizeof(query),"Você criou uma fábrica com o ID: {DBED15}%d Valor: $%s.",id,Numeros(precio));
			else format(query,sizeof(query),"Você criou uma fábrica com o ID: {DBED15}%d Valor: %d Bz.",id,precio);
			SendClientMessage(playerid,-1,query);

			format(query,sizeof(query),"Escreva: {F7EF05}/criargaragemfabrica %d{FFFFFF} para criar uma garagem para a fabrica. lembre-se de sempre olhar para o lado da porta.", id);
			SendClientMessage(playerid,-1,query);
		}
		else SendClientMessage(playerid,-1,"Escreva: {F7EF05}/criarfabrica [valor] [dinheiro 0] [1 moeda]{FFFFFF} Para criar uma fábrica.");
	}
	return 1;
}


