		autoid = GetPlayerVehicleID(playerid);
		if(!IsPlayerInAnyVehicle(playerid)) return SendClientMessage(playerid,-1,"Você precisa dirigir o veículo para reabastecer.");
		if(!EnGasolinera(playerid)) return SendClientMessage(playerid,-1,"Você precisa levar o veículo a um posto de gasolina.");
		if(litros < 0) return SendClientMessage(playerid, -1, "O combustível deve ser maior que 0.");

		new modelo = GetVehicleModel(autoid);
		new vehiclefuel = CombustibleCoche(modelo);
		if(VehicleFuel[autoid] >= vehiclefuel) return SendClientMessage(playerid, -1, "O tanque deste veículo está cheio.");
    	{
			new nuevacantidad = litros+VehicleFuel[autoid];
			if(nuevacantidad > vehiclefuel) return SendClientMessage(playerid,-1,"Você não pode reabastecer essa quantidade de combustível.");
			petroleo = VehicleFuel[autoid]+litros;
			if(PlayerInfo[playerid][jDinero] < litros*10)
			{
				format(string,128,"O litro de combustível custa {00CC00}$10{FFFFFF}, você precisa de {00CC00}$%d{FFFFFF} para pagar {0BC8D5}%d{FFFFFF} litros.",litros*10, litros);
				SendClientMessage(playerid, -1,string);
				return 1;
			}
			llenado[autoid] = SetTimerEx("DarGasolina",1000,true,"dd", autoid, petroleo);
			format(string,128,"Eles vão carregar %d litros de combustível.", litros);
			SendClientMessage(playerid, -1,string);
			format(string,128,"Custo total: {00CC00}$%d{FFFFFF}.", litros*10);
			SendClientMessage(playerid, -1,string);
			TogglePlayerControllable(playerid, 0);
			SetPVarInt(playerid, "IsFrozen", 0);
			QuitarDinero(playerid, litros*10);
			SinGaso[autoid] = 0;
			TimerCombustible[playerid] = 150;
		}
	}
	return 1;
}

