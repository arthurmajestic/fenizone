		    if(PlayerInfo[playerid][pTiempoCarcelM] > 0 || PlayerInfo[playerid][pTiempoJail] > 0) return SendClientMessage(playerid,-1,"Você não pode criar uma arma neste momento.");
		    if(puedeCrearArmas(playerid) == 0) return SendClientMessage(playerid,-1,"Você não pode criar armas neste momento.");
		    if(!EstaHospital(playerid))
		    {
		    	if(PlayerInfo[playerid][pNivelArmero] > 0){format(string, sizeof(string),"9MM\n9mm silenciada\n");}
				if(PlayerInfo[playerid][pNivelArmero] > 1){format(string, sizeof(string),"%sEscopeta\n",string);}
				if(PlayerInfo[playerid][pNivelArmero] > 2){format(string, sizeof(string),"%sDesert Eagle\n",string);}
				if(PlayerInfo[playerid][pNivelArmero] > 3){format(string, sizeof(string),"%sMP5\n",string);}
				if(PlayerInfo[playerid][pNivelArmero] > 4){format(string, sizeof(string),"%sAK-47\nM4\n",string);}
				if(PlayerInfo[playerid][pNivelArmero] > 5){format(string, sizeof(string),"%sRifle\n",string);}
				if(PlayerInfo[playerid][pNivelArmero] > 6){format(string, sizeof(string),"%sEscopeta de combate\n",string);}
				if(PlayerInfo[playerid][pNivelArmero] > 7){format(string, sizeof(string),"%sGranada\n",string);}
		    	ShowPlayerDialog(playerid, D_CARMA, DIALOG_STYLE_LIST, "Trabalho de armeiro: criação de armas", string,"Aceitar", "Cancelar");
		    	return 1;
			}
		}
		if(PlayerInfo[playerid][pTrabajo] != T_Ladron && PlayerInfo[playerid][pTrabajo2] != T_Ladron) return 1;
		if(PlayerInfo[playerid][Agonizando] == 1) return SendClientMessage(playerid,-1,"Você não pode criar armas neste momento.");
		if(GetPlayerState(playerid) == 2 || GetPlayerState(playerid) == 3) return SendClientMessage(playerid, -1, "Você não pode criar uma arma se estiver em um veículo.");
		if(PlayerInfo[playerid][pTiempoCarcelM] > 0 || PlayerInfo[playerid][pTiempoJail] > 0) return SendClientMessage(playerid,-1,"Você não pode criar uma arma neste momento.");

		if(puedeCrearArmas(playerid) == 0) return SendClientMessage(playerid,-1,"Você não pode criar armas neste momento.");
		if(EstaHospital(playerid)) return 1;
		new nombre_arma[64],string[128],Piezas,armaid,lvlid;
		if(strcmp(item, "9mm",	 true) == 0) { armaid = 22; lvlid = 1; format(nombre_arma,sizeof(nombre_arma),"9mm"); Piezas = 10;}
		else if(strcmp(item, "9mm-silenciada",	true) == 0) { armaid = 23; lvlid = 2; format(nombre_arma,sizeof(nombre_arma),"9mm silenciada"); Piezas = 12; }
		else if(strcmp(item, "escopeta",	true) == 0) { armaid = 25; lvlid = 2; format(nombre_arma,sizeof(nombre_arma),"Escopeta"); Piezas = 20;}
		else if(strcmp(item, "dk",	true) == 0) { armaid = 24; lvlid = 3; format(nombre_arma,sizeof(nombre_arma),"Desert Eagle"); Piezas = 36;}
		else if(strcmp(item, "desert-eagle",	true) == 0) { armaid = 24; lvlid = 3; format(nombre_arma,sizeof(nombre_arma),"Desert Eagle"); Piezas = 36;}
		else if(strcmp(item, "mp5",	true) == 0) { armaid = 29; lvlid = 4; format(nombre_arma,sizeof(nombre_arma),"Mp5"); Piezas = 58;}
		else if(strcmp(item, "ak47",	true) == 0) { armaid = 30; lvlid = 5; format(nombre_arma,sizeof(nombre_arma),"AK-47"); Piezas = 82;}
		else if(strcmp(item, "m4",	true) == 0) { armaid = 31; lvlid = 5; format(nombre_arma,sizeof(nombre_arma),"M4"); Piezas = 96; }
		else if(strcmp(item, "rifle",	true) == 0) { armaid = 33; lvlid = 6; format(nombre_arma,sizeof(nombre_arma),"Rifle"); Piezas = 52;}
		else if(strcmp(item, "edc",	true) == 0) { armaid = 27; lvlid = 7; format(nombre_arma,sizeof(nombre_arma),"Escopeta de combate"); Piezas = 136;}
		else if(strcmp(item, "escopeta-de-combate",	true) == 0) { armaid = 27; lvlid = 7; format(nombre_arma,sizeof(nombre_arma),"Escopeta de combate"); Piezas = 136;}
		else if(strcmp(item, "granada",	true) == 0) { armaid = 16; lvlid = 8; format(nombre_arma,sizeof(nombre_arma),"Granada"); Piezas = 1200;}
		else return 1;
		if(IsPlayerInAnyVehicle(playerid)) return SendClientMessage(playerid,-1,"Você não pode criar armas em veículos.");
		if(PlayerInfo[playerid][pNivelArmero] < lvlid) return SendClientMessage(playerid, -1, "Você não tem o nível necessário para criar esta arma");
		if(PlayerInfo[playerid][pMateriales] >= Piezas)
		{
			PlayerInfo[playerid][pMateriales] -= Piezas;
			DarArma(playerid, armaid);
			format(string,sizeof(string),"%s tira peças de sua mochila e cria um/uma %s.",PlayerInfo[playerid][Nickname], nombre_arma);
			ProxDetector(20, playerid, string, COLOR_VERDECLARO,COLOR_VERDECLARO,COLOR_VERDECLARO,COLOR_VERDECLARO,COLOR_VERDECLARO);
			SetHabilityWeaponJob(playerid,lvlid);
		}
		else return SendClientMessage(playerid, -1, "Você não tem os materiais necessários");
	}
	return 1;
}
