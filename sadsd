				}
				SendClientMessage(playerid, -1,"{0BC8D5}Acabou de notificar o cliente de que irá reparar o seu veículo.");
				ResponderMeca[playerid] = 0;
			}
			else return SendClientMessage(playerid,-1,"Todas as chamadas já foram atendidas.");
		}
	}
	return 1;
}

