forward AbrindoPorta1(playerid);
public AbrindoPorta1(playerid)
{
	
	if(TempoCarregando[playerid] >= 1)
	{
		TempoCarregando[playerid] += 1;
	}
	new string2[50];
	format(string2,sizeof(string2),"%d%",TempoCarregando[playerid]);
	PlayerTextDrawSetString(playerid,PORCENTOC[playerid],string2);
	PlayerTextDrawShow(playerid,PORCENTOC[playerid]);
	
	PlayerTextDrawSetString(playerid,CARREGANDOC[playerid],"~w~ARROMBANDO ~g~PORTA~w~");
	PlayerTextDrawShow(playerid,CARREGANDOC[playerid]);
	
	if(TempoCarregando[playerid] == 5)
	{		
		switch(PlayerInfo[playerid][pNivelLadron])
		{
			case 1:
			{
				TempoCarregando[playerid] = 25;
			}
			case 2:
			{
				TempoCarregando[playerid] = 50;
			}
			default:
			{
				TempoCarregando[playerid] = 75;
			}
		}
	}
	if(TempoCarregando[playerid] == 100)
	{ 
		TempoCarregando[playerid] = 0;
		KillTimer(ROUBANDO1[playerid]);
		TogglePlayerControllable(playerid,1);
		SetPVarInt(playerid, "IsFrozen", 1);
		SetCameraBehindPlayer(playerid);
