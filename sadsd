CMD:reiniciar25(playerid,params[])
{
	new string[250],tiempo;
	if(PlayerInfo[playerid][pAdmin] < ADMIN_LEVEL_ADM) return 0;
	if(ComandoEstado == 0) return SendClientMessage(playerid,-1,"A reinicialização do servidor já está ativa.");
	if(!sscanf(params,"d",tiempo))
	{
	    if(tiempo < 2) return SendClientMessage(playerid,-1,"O tempo para reiniciar deve ser maior que 1.");
	    ComandoEstado = 0;
	    TiempoReinicio = tiempo*60;
		format(string,250,"O servidor irá reiniciar automaticamente em %d minutos.",tiempo);
		SendClientMessageToAll(0xb5bfcbFF, string);
	}
	else return SendClientMessage(playerid,-1,"Escreva /reiniciaron [minutos]");
	return 1;
}

CMD:reiniciaroff25(playerid)
{
	if(PlayerInfo[playerid][pAdmin] < ADMIN_LEVEL_ADM) return 0;
	if(ComandoEstado == 1) return SendClientMessage(playerid,-1,"A reinicialização do servidor não está habilitada.");
	{
		for(new i = 0; i < MAX_PLAYERS; i++)
		{
		    NoQuitar[i] = 0;
		}
	    ComandoEstado = 1;
	    TiempoReinicio = -1;
		SendClientMessageToAll(0xb5bfcbFF, "A reinicialização do servidor foi cancelada.");
	}
	return 1;
}
CMD:inscreverse(playerid,params[])
{
	if(IsPlayerInRangeOfPoint(playerid,5,-1447.7421,-313.3544,1052.0969))
	{
		if(HabilitarCarreras == 0) return SendClientMessage(playerid,-1,"Você não pode mais se registrar, aguarde a próxima corrida.");
		if(EnCarreras[playerid] != 0) return SendClientMessage(playerid,-1,"Você já está inscrito na corrida.");
		if(PlayerInfo[playerid][jDinero] < 2000) return SendClientMessage(playerid,-1,"Você precisa {00CC00}$2.000{FFFFFF} para poder se inscrever na corrida.");
		if(EmpezoCarrera == 1) return SendClientMessage(playerid,-1,"Você não pode se registrar, a corrida já começou.");
		if(ParticipantesCarrera >= 10) return SendClientMessage(playerid,-1,"Não há mais vagas livres para a corrida, aguarde a próxima.");
		if(PlayerInfo[playerid][@Nivel] < 4) return SendClientMessage(playerid,-1,"Você precisa do nível 4 para se inscrever.");
		QuitarDinero(playerid,2000);
		lugarcarrera ++;
		EnCarreras[playerid] = lugarcarrera;
		ParticipantesCarrera ++;
		ParticipantesCarrera2 ++;
		SendClientMessage(playerid,-1,"Você se inscreveu para participar da corrida, aguarde alguns minutos.");
		SendClientMessage(playerid,-1,"Você perderá sua posição se sair do estádio.");
    }
	if(IsPlayerInRangeOfPoint(playerid,5, 415.2025,2535.5874,19.1484))
	{
	    if(ViajeAvion[playerid] == 1) return SendClientMessage(playerid,-1,"Você já está inscrito no curso de paraquedismo.");
	    if(PlayerInfo[playerid][jDinero] < 5000) return SendClientMessage(playerid,-1,"Você precisa {00CC00}$5.000{FFFFFF} para poder se inscrever no curso de paraquedismo.");
		SendClientMessage(playerid,-1,"Você se inscreveu para participar do curso de paraquedismo, aguarde alguns minutos.");
		SendClientMessage(playerid,-1,"Se você se afastar muito do escritório, não conseguirá entrar no avião.");
		QuitarDinero(playerid, 5000);
		ViajeAvion[playerid] = 1;
		return 1;
	}
	return 1;
}

