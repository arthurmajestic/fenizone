CMD:chamar(playerid, params[])
{
	new string[250], phonenumb;
	if(PlayerInfo[playerid][pNumero] == 0)
	{
	    SendClientMessage(playerid,-1,"Você precisa comprar um telefone celular para fazer chamadas.");
	    SendClientMessage(playerid,-1,"Você pode comprar um telefone em qualquer {0BC8D5}24/7{FFFFFF}.");
	    return 1;
	}
	if(GetPlayerMoney(playerid) < 25) return SendClientMessage(playerid,-1,"Voce nao tem dinheiro suficiente para fazer uma ligacao, voce precisa {FF3300}$15{FFFFFF} a cada 30 segundos.");
	if(sscanf(params, "d", phonenumb)) return SendClientMessage(playerid, COLOR_WHITE, "Escreva {0BC8D5}/chamar número{FFFFFF}.");
	if(PlayerInfo[playerid][pTiempoCarcelM] > 0 || PlayerInfo[playerid][pTiempoJail] > 0) return SendClientMessage(playerid,-1,"Eles pegaram seu telefone antes de colocá-lo na prisão.");
    if(phonenumb == 911 && PlayerInfo[playerid][pDuty] == 1) return SendClientMessage(playerid, -1, "Você não pode ligar para o 911 se você for um policial ativo, use seu rádio.");
	if(PlayerInfo[playerid][pNumero] == phonenumb) return SendClientMessage(playerid,-1,"Número inválido");
	if(EnLlamada[playerid] == 1) return SendClientMessage(playerid,-1,"Você já está em uma chamada, escreva /finalizar para terminar");
	if(TelefonoEstado[playerid] > 0)
	{
	    TelefonoEstado[playerid] = 1;
	    if(PlayerTemp[playerid][@Specteando] == 0) AccionesRol(playerid,"ligou o celular.", 20);
	}
	if(PlayerInfo[playerid][Agonizando] != 1)	{  SetPlayerSpecialAction(playerid, SPECIAL_ACTION_USECELLPHONE);   }
	PlayerPlaySound(playerid, 3600, 0.0, 0.0, 0.0);
	for(new i=0;i<MAX_PLAYERS; i++)
	{
		if(phonenumb == 911)
		{
			PlayerInfo[playerid][MobileSub] = 911;
			if(PlayerInfo[playerid][Agonizando] != 1)	{  SetPlayerSpecialAction(playerid, SPECIAL_ACTION_USECELLPHONE);   }
			SetTimerEx("LlamadaCops",2000,false,"d",playerid);
            LlamadaTipo[playerid] = 1;
			SendClientMessage(playerid, -1, "Chamando a policia... Escreva {0BC8D5}/finalizar{FFFFFF} para cancelar a chamada.");
			return 1;
		}
		if(phonenumb == 815)
		{
			PlayerInfo[playerid][MobileSub] = 815;
			if(PlayerInfo[playerid][Agonizando] != 1)	{  SetPlayerSpecialAction(playerid, SPECIAL_ACTION_USECELLPHONE);   }
			SetTimerEx("LlamadaGrua",3000,false,"d",playerid);
            LlamadaTipo[playerid] = 1;
			SendClientMessage(playerid, -1, "Chamando o serviço de guincho... Escreva {0BC8D5}/finalizar{FFFFFF} para cancelar a chamada.");
			return 1;
		}
		if(phonenumb == 71) return callcmd::solicitar(playerid,"medico");
		if(phonenumb == 80) return callcmd::solicitar(playerid,"mecanico");
		if(PlayerInfo[i][pNumero] == phonenumb && phonenumb != 0)
		{
		    if(PlayerInfo[i][pTiempoCarcelM] > 0 || PlayerInfo[i][pTiempoJail] > 0) return SendClientMessage(playerid,-1,"O número que você discou não está disponível no momento.");
			if(EnLlamada[i] == 1) return SendClientMessage(playerid,-1,"O número que você discou está ocupado");
			if(TelefonoEstado[i] == 1) return SendClientMessage(playerid,-1,"O número que você discou está offline");
			{
				if(IsPlayerConnected(i)){
					if(i != INVALID_PLAYER_ID){
						if(PlayerInfo[i][MobileSub] == INVALID_PLAYER_ID)
						{
							if(PlayerTemp[i][@Specteando] == 1) return 1;
							SendClientMessage(playerid,-1,"Chamando... escreva {0BC8D5}/finalizar{FFFFFF} para cancelar a chamada.");
							format(string, sizeof(string), "O telefone de %s está tocando.", PlayerInfo[i][Nickname]);
							ProxDetector(30.0, i, string, COLOR_VERDECLARO,COLOR_VERDECLARO,COLOR_VERDECLARO,COLOR_VERDECLARO,COLOR_VERDECLARO);
							format(string, sizeof(string), "Alguém está ligando para você por telefone do número: {0BC8D5}%d{FFFFFF}, escreva {0BC8D5}/atender{FFFFFF} o {0BC8D5}/finalizar{FFFFFF}.", PlayerInfo[playerid][pNumero]);
							CLlamada[playerid] = SetTimerEx("finllamadax", 30000, false, "ii", playerid,i);
							SendClientMessage(i, -1, string);
							YoLlame[playerid] = 1;
							PlayerInfo[playerid][MobileSub] = i;
							PlayerInfo[i][MobileSub] = playerid;
							llamada(i);
							return 1;
						}
					}
				}
			}
		}
	}
	SendClientMessage(playerid, COLOR_GRAD2, "Sua chamada não pode passar pelo número discado, verifique o número e tente novamente.");
	SetTimerEx("StopCell",3000,false,"d",playerid);
	return 1;
}
CMD:sms(playerid, params[])
{
	if(PlayerInfo[playerid][pNumero] > 0)
	{
	    if(PlayerInfo[playerid][pTiempoCarcelM] > 0 || PlayerInfo[playerid][pTiempoJail] > 0) return SendClientMessage(playerid,-1,"Você não pode usar seu telefone neste momento.");
		if(PlayerInfo[playerid][jDinero] >= 15)
		{
			new numero, mensaje[256], mensaje2[256];
			if(!sscanf(params,"ds[110]",numero,mensaje))
			{
			    if(PlayerInfo[playerid][pNumero] == numero) return SendClientMessage(playerid,-1,"Você não pode enviar um SMS para si mesmo.");
				EnviarSMS(playerid, numero, mensaje);
				return 1;
			}
			else if(!sscanf(params,"s[110]",mensaje2))
			{
				if(GetPVarInt(playerid, "NumeroSMS") > 0)
				{
					EnviarSMS(playerid, GetPVarInt(playerid, "NumeroSMS"), mensaje2);
					return 1;
				}
				else if(GetPVarInt(playerid, "NumeroSMS") == 0)
				{
					SendClientMessage(playerid, COLOR_WHITE, "El mensaje {0BC8D5}no se pudo entregar{FFFFFF}, verifique se o número está correto.");
					SendClientMessage(playerid, COLOR_WHITE, "Se o número estiver correto, o telefone provavelmente está desligado.");
					return 1;
				}
			}
			SendClientMessage(playerid, COLOR_WHITE, "Escreva {0BC8D5}/sms número texto{FFFFFF}. Ex: {0BC8D5}/sms 5099999 Olá tudo bem?.");
		}
		else return SendClientMessage(playerid, COLOR_WHITE, "Voce nao tem dinheiro suficiente pra mandar um sms, voce precisa {FF4202}$15{FFFFFF}.");
	}
	else
	{
	    SendClientMessage(playerid,-1,"Você precisa comprar um telefone celular para enviar mensagens de texto.");
	    SendClientMessage(playerid,-1,"Você pode comprar um telefone em qualquer {DBED15}24/7{FFFFFF}.");
	    return 1;
	}
	return 1;
}
CMD:atender(playerid, params[])
{
	new string[150],texto[10],id,Float:Pos[3];
	if(!sscanf(params,"s[10]d",texto,id))
	{
		if(strcmp(texto, "paciente", true)==0)
		{
			new Float:Vida;
			if(PlayerInfo[playerid][pTrabajo] != T_Medico && PlayerInfo[playerid][pTrabajo2] != T_Medico) return SendClientMessage(playerid,-1,"Você precisa do trabalho de um médico para usar este comando");
			if(GetPlayerSkin(playerid) == 274 || GetPlayerSkin(playerid) == 275 || GetPlayerSkin(playerid) == 276 || GetPlayerSkin(playerid) == 308)
			{
				if(PlayerInfo[playerid][pMedicina] == 0) return SendClientMessage(playerid,-1,"Você não tem nenhum medicamento para aplicar");
				GetPlayerPos(id,Pos[0],Pos[1],Pos[2]);
				if(!IsPlayerInRangeOfPoint(playerid, 2.0,Pos[0],Pos[1],Pos[2])) return SendClientMessage(playerid,-1,"Você não está perto deste paciente");
				if(PlayerInfo[id][pAtendido] == 1) return SendClientMessage(playerid,-1,"Este paciente já foi tratado por outro médico");
				GetPlayerHealth(id,Vida);
				if(PlayerInfo[id][pEnfermedad] == PlayerInfo[playerid][pMedicina])
				{
					if(Vida < 90) { EstablecerVida(id, 90); }
					AccionesRol(playerid,"aplica o tratamento necessário com o paciente.", 20);
					format(string,sizeof(string),"%s começa a curar as feridas de %s ",PlayerInfo[playerid][Nickname],PlayerInfo[id][Nickname]);
					ProxDetector(20.0, playerid, string, COLOR_VERDECLARO,COLOR_VERDECLARO,COLOR_VERDECLARO,COLOR_VERDECLARO,COLOR_VERDECLARO);
					format(string,sizeof(string),"O tratamento parece estar indo bem");
					ProxDetector(5.0, playerid, string, COLOR_VERDECLARO,COLOR_VERDECLARO,COLOR_VERDECLARO,COLOR_VERDECLARO,COLOR_VERDECLARO);
					PlayerInfo[id][pAtendido] = 1;
					PlayerInfo[playerid][pMedicina] = 0;
					if(PlayerInfo[id][jDinero] >= 600)
					{
						QuitarDinero(id,600);
						DarDinero(playerid,600);
						SendClientMessage(playerid,-1,"O paciente pagou a você {00CC00}$600{FFFFFF} pelo seu ótimo trabalho");
						SendClientMessage(id,-1,"Você pagou {00CC00}$600{FFFFFF} de sua carteira para o médico pelo trabalho dele");
					}
					else if(PlayerInfo[id][pBanco] >= 600)
					{
						PlayerInfo[id][pBanco] -= 600;
						DarDinero(playerid,600);
						SendClientMessage(playerid,-1,"O paciente pagou a você {00CC00}$600{FFFFFF} por tu gran trabajo");
						SendClientMessage(id,-1,"Você pagou {00CC00}$600{FFFFFF} do banco ao médico por seu trabalho");
					}
					else
					{
						DarDinero(playerid,250);
						SendClientMessage(playerid,-1,"O paciente não tem dinheiro suficiente para pagar os serviços, o hospital pagou a você $250");
						SendClientMessage(id,-1,"Você não teve dinheiro para pagar ao médico, o hospital cobriu sua taxa");
					}
				}
				else
				{
					if(Vida > 10) { EstablecerVida(id, 10); }
					AccionesRol(playerid,"aplica o tratamento errado ao paciente.", 20);
					SendClientMessage(playerid,COLOR_RED,"Você aplicou o tratamento errado com o paciente, sua reputação como médico diminuiu");
				}
			}
			else return SendClientMessage(playerid,-1,"Você precisa ter as roupas médicas para usar este comando");
		}
		return 1;
	}
	if(sscanf(params, "s[30]", texto))
	{
		for(new i=0;i<MAX_PLAYERS;i++)
		{
			if(PlayerInfo[i][MobileSub] == 911)
			{
				if(PlayerInfo[playerid][pDuty] == 1)
				{
					EnLlamada[playerid] = 1;
					PlayerInfo[i][Mobile] = playerid;
					PlayerInfo[i][MobileSub] = INVALID_PLAYER_ID;
					EnLlamada911[i] = 911;
					PlayerInfo[playerid][Mobile] = i;
					PlayerInfo[playerid][MobileSub] = INVALID_PLAYER_ID;
					EnLlamada911[playerid] = 911;
					format(string,sizeof(string),"{3399FF}[Central de polícia]{FFFFFF} %s %s atender a chamada de %s.",RangoPolicia(playerid),PlayerInfo[playerid][Nickname],PlayerInfo[i][Nickname]);
					SendRadioMessage(1,-1,string,INVALID_PLAYER_ID,1);
					format(string,sizeof(string),"{3399FF}[Central de polícia]{FFFFFF} %s %s atendeu sua chamada",RangoPolicia(playerid),PlayerInfo[playerid][Nickname]);
					SendClientMessage(i, -1, string);
					if(PlayerInfo[i][Agonizando] != 1)	{  SetPlayerSpecialAction(i, SPECIAL_ACTION_USECELLPHONE);   }
					if(PlayerInfo[playerid][Agonizando] != 1)	{  SetPlayerSpecialAction(playerid, SPECIAL_ACTION_USECELLPHONE);   }
					return 1;
				}
			}
		}
		if(Mobile2[playerid] == 2540)
		{
			finllamada(playerid);
			EnLlamada[playerid] = 1;
			Mobile2[playerid] = 0;
			PlayerInfo[playerid][MobileSub] = 2540;
			SendClientMessage(playerid,-1,"Atende a ligação.");
			SetTimerEx("MandarMensajeTransportistas",2000,false,"d",playerid);
		}
		else if(PlayerInfo[playerid][MobileSub] != INVALID_PLAYER_ID)
		{
			for(new u=0;u<MAX_PLAYERS;u++)
			{
				if(PlayerInfo[u][MobileSub] == playerid)
				{
                    KillTimer(CLlamada[playerid]);
                    KillTimer(CLlamada[u]);
					finllamada(playerid);
					EnLlamada[playerid] = 1;
					EnLlamada[u] = 1;
					PlayerInfo[playerid][Mobile] = u;
					PlayerInfo[u][Mobile] = playerid;
					PlayerInfo[u][MobileSub] = INVALID_PLAYER_ID;
					PlayerInfo[playerid][MobileSub] = INVALID_PLAYER_ID;
					SendClientMessage(playerid,-1,"Atende a ligação.");
					SendClientMessage(u,  -1, "Atenderam a chamada.");
					AccionesRol(playerid,"atende seu telefone.", 20);
					if(PlayerInfo[playerid][Agonizando] != 1)	{  SetPlayerSpecialAction(playerid, SPECIAL_ACTION_USECELLPHONE);   }
					if(PlayerInfo[u][Agonizando] != 1)	{  SetPlayerSpecialAction(u, SPECIAL_ACTION_USECELLPHONE);   }
					return 1;
				}
			}
		}
		else return SendClientMessage(playerid,-1,"Não há chamada para atender.");
	}
	return 1;
}
