CMD:prender(playerid, params[])
{
	new ID, Lugar, patrulla, Float:x, Float:y, Float:z;
	patrulla = GetPlayerVehicleID(playerid);
	if(sscanf(params, "dd", ID, Lugar))return SendClientMessage(playerid,-1,"Escreva {DBED15}/prender [ ID ] [ {F7EF05}1 = Assento esquerdo {DBED15}] {FFFFFF}|| {DBED15}[ {F7EF05}2 = Assento direito {DBED15}]");
    if(PlayerInfo[playerid][pDuty] != 1) return SendClientMessage(playerid, -1, "Você não está com um uniforme de policial.");
	if(IsPlayerNPC(ID)) return 1;
	if(!IsPlayerConnected(ID)) return 1;
	if(PlayerInfo[ID][Agonizando] != 1 && Esposando[ID] != 2) return SendClientMessage(playerid,-1,"O suspeito não está algemado ou abatido.");
	if(PlayerInfo[ID][pCargos] == 0) return SendClientMessage(playerid,-1,"Este jogador não tem acusações.");
	if(!IsPlayerInAnyVehicle(playerid)) return SendClientMessage(playerid,-1,"Você deve estar em um veículo de polícia.");
	if(GetVehicleModel(GetPlayerVehicleID(playerid)) == 528 || GetVehicleModel(GetPlayerVehicleID(playerid)) == 601) return SendClientMessage(playerid,-1,"Você deve estar em uma viatura de polícia ou helicóptero.");
	if(!SAPD(patrulla) && !HELISAPD(patrulla)) return SendClientMessage(playerid,-1,"Você precisa estar dirigindo um veículo de polícia para prender alguém.");
	if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return SendClientMessage(playerid,-1,"Você deve estar dirigindo a patrulha.");
	GetPlayerPos(ID, x,y,z);
	if(IsPlayerInRangeOfPoint(playerid, 40.0,  x, y,z))
	{
	    switch(Lugar)
	    {
	        case 1: PutPlayerInVehicle(ID, patrulla, 2);
	        case 2: PutPlayerInVehicle(ID, patrulla, 3);
	        default: return 1;
	    }
    	QuitarArmas(ID);
		SetPlayerArmedWeapon(ID, 0);
		BajandoV[ID] = 0;
		EnAuto[ID] = patrulla;
		EnPatrulla[ID] = 1;
		PlayerInfo[ID][Agonizando] = 0;
		TogglePlayerControllable(ID, 0);
		SetPVarInt(ID, "IsFrozen", 0);
		AccionesRol(playerid,"colocou o detido em sua viatura.", 20);
	}
	else SendClientMessage(playerid, -1, "Aproxima a viatura para prender o prisioneiro.");
	return 1;
}

