			{
				case 0:	{ format(string, sizeof(string), "{779ab5}%s foi expulso da administração.",PlayerInfo[ID][Nickname]); format(strong, sizeof(strong), "{779ab5}%s expulsou você da administração.",PlayerInfo[playerid][Nickname]); }
				case 1:	{ format(string, sizeof(string), "{779ab5}%s foi designado a Ajudante.",PlayerInfo[ID][Nickname]); format(strong, sizeof(strong), "{779ab5}%s lhe tornou Ajudante.",PlayerInfo[playerid][Nickname]); }
				case 2:	{ format(string, sizeof(string), "{779ab5}%s foi designado a Moderador Canal Dúvidas.",PlayerInfo[ID][Nickname]); format(strong, sizeof(strong), "{779ab5}%s lhe tornou Moderador Canal Dúvidas",PlayerInfo[playerid][Nickname]); }
				case 3:	{ format(string, sizeof(string), "{779ab5}%s foi designado a Moderador do Jogo.",PlayerInfo[ID][Nickname]); format(strong, sizeof(strong), "{779ab5}%s lhe tornou Moderador do Jogo.",PlayerInfo[playerid][Nickname]); }
				case 4:	{ format(string, sizeof(string), "{779ab5}%s foi designado a Moderador Global.",PlayerInfo[ID][Nickname]); format(strong, sizeof(strong), "{779ab5}%s lhe tornou Moderador Global.",PlayerInfo[playerid][Nickname]); }
				case 5:	{ format(string, sizeof(string), "{779ab5}%s foi designado a Administrador.",PlayerInfo[ID][Nickname]); format(strong, sizeof(strong), "{779ab5}%s lhe tornou Administrador.",PlayerInfo[playerid][Nickname]); }

			}
			if(ADMIN > 0) VerAdmin[ID] = 1;
			SendClientMessage(ID, -1, strong);
