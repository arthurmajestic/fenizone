							SetPlayerWantedLevel(i,PlayerInfo[i][pCargos]);
						}
					}
					else
					{
						PlayerInfo[i][pCargos] = 0;
						ActualizarRadar();
						SetPlayerWantedLevel(i,PlayerInfo[i][pCargos]);
